# Streamlit Secrets 견본 — 값은 넣지 않습니다.
# 진짜 키는 Streamlit Community Cloud → 내 앱 → Settings → Secrets 칸에만 붙여 넣습니다.
# 내 PC에서 쓰려고 이 파일을 secrets.toml로 복사했다면 secrets.toml은 커밋하지 않습니다(.gitignore가 막지만 웹 업로드는 막지 못합니다).
# 앱이 요구하는 다른 칸은 과정 저장소의 app/.streamlit/secrets.toml.example을 따릅니다.

[llm]
base_url = "<키 카드에 적힌 주소>"
api_key = "<내 가상 키 — 이 파일이 아니라 Secrets 칸에만>"
default_model = "fast-default"
fallback_models = ["fast-backup"]
